<?xml version="1.0"?>
<robot name="my_object">
  <link name="object_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://environment/meshes/obj.stl" scale="2.2 2.2 2.2"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://environment/meshes/obj.stl" scale="2.2 2.2 2.2"/>
      </geometry>
    </collision>
  </link>

  <gazebo reference="object_link">
    <static>true</static>
  </gazebo>
</robot>
